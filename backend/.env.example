DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use DATABASE_URL or the POSTGRES_* variables. PostgreSQL is required.
# DATABASE_URL=postgres://yakwetu:yakwetu@127.0.0.1:5432/yakwetu
POSTGRES_DB=yakwetu
POSTGRES_USER=yakwetu
POSTGRES_PASSWORD=yakwetu
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave the webhook blank until n8n is ready. Events are still stored.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
